        allow list: if isSignedIn() && isVerified() && isCompanyMember(companyId) && request.auth.uid in resource.data.memberUids;
        allow create: if isSignedIn() && isVerified() && isValidId(companyId) && isValidId(sessionId)
          && isValidStoreSession(incoming()) && hasValidTenantHeader(incoming(), sessionId, companyId)
          && isCompanyMember(companyId)
          && hasCurrentCompanyMembers(incoming(), companyId)
          && incoming().ownerUid == getCompany(companyId).data.ownerUid
          && incoming().status == 'open'
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isVerified() && isValidId(companyId) && isValidId(sessionId)
          && isValidStoreSession(incoming()) && hasValidTenantHeader(incoming(), sessionId, companyId)
          && isCompanyMember(companyId) && preservesTenantImmutables()
          && (
            (existing().status == 'open'
              && incoming().status == 'closed'
              && incoming().openedAtMs == existing().openedAtMs
              && incoming().openingCash == existing().openingCash
              && incoming().sessionNumber == existing().sessionNumber
              && incoming().branchId == existing().branchId
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'closedByStaffId', 'closedByStaffName', 'closedAtMs',
                'expectedCash', 'closingCashActual', 'expectedCard', 'actualCard',
                'expectedTransfer', 'actualTransfer', 'varianceTotal', 'salesCount',
