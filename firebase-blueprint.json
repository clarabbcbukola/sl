{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Multi-branch business tenant configuration and ownership record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 10 },
        "taxRate": { "type": "number" },
        "taxInclusive": { "type": "boolean" },
        "wholesaleDiscountPct": { "type": "number" },
        "address": { "type": "string", "maxLength": 250 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "receiptFooter": { "type": "string", "maxLength": 300 },
        "allowNegativeStock": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "currency", "taxRate", "taxInclusive", "wholesaleDiscountPct",
        "address", "phone", "email", "receiptFooter", "allowNegativeStock",
        "ownerUid", "memberUids", "createdAt", "updatedAt"
      ]
    },
    "Branch": {
      "title": "Branch",
      "description": "Physical store or warehouse branch belonging to a company.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "code": { "type": "string", "minLength": 1, "maxLength": 20 },
        "address": { "type": "string", "maxLength": 250 },
        "phone": { "type": "string", "maxLength": 40 },
        "isMain": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "companyId", "ownerUid", "memberUids", "name", "code",
        "address", "phone", "isMain", "active", "createdAt", "updatedAt"
      ]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "POS operator / staff user with hashed PIN and role permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier", "accountant"] },
        "branchId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pinHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "companyId", "ownerUid", "memberUids", "name", "role",
        "branchId", "pinHash", "active", "createdAt", "updatedAt"
      ]
    },
