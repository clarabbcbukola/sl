  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Tenant company records owned by authenticated users."
    },
    "/companies/{companyId}/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Branches belonging to a company."
    },
    "/companies/{companyId}/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Staff operators and PIN hashes belonging to a company."
    },
    "/companies/{companyId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Branch-scoped inventory products."
    },
    "/companies/{companyId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Retail and wholesale POS sales transactions."
    },
    "/companies/{companyId}/heldCarts/{cartId}": {
      "schema": { "$ref": "#/entities/HeldCart" },
      "description": "Held POS carts synchronized across devices."
    },
    "/companies/{companyId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Inventory purchases and operating expenditures."
    },
    "/companies/{companyId}/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/StockTransfer" },
      "description": "Inter-branch stock transfer logs."
    },
    "/companies/{companyId}/returns/{returnId}": {
      "schema": { "$ref": "#/entities/StockReturn" },
      "description": "Customer returns and refunds."
    },
    "/companies/{companyId}/stockTakes/{stockTakeId}": {
      "schema": { "$ref": "#/entities/StockTake" },
      "description": "Stock take and reset audit records."
    },
    "/companies/{companyId}/reconciliations/{reconciliationId}": {
      "schema": { "$ref": "#/entities/Reconciliation" },
      "description": "Daily financial reconciliations."
    }
  }
}
