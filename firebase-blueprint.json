        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "companyId", "ownerUid", "memberUids", "trackingNumber", "branchId",
        "branchName", "staffId", "staffName", "saleMode", "customerName", "customerPhone",
        "paymentMethod", "items", "subtotal", "discountAmount", "taxAmount", "total",
        "totalCost", "amountTendered", "changeDue", "returnedAmount", "status",
        "notes", "dateKey", "createdAt", "updatedAt"
